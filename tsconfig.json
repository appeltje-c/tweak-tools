{
    "compilerOptions": {
        "outDir": "./dist",
        "module": "ESNext",
        "target": "ESNext",
        "moduleResolution": "node",
        "jsx": "react-jsx",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "declaration": true,
        "typeRoots": [
            "./types"
        ],
        "lib": [
            "ESNext",
            "dom"
        ]
    },
    "include": [
        "src/**/*"
    ]
}